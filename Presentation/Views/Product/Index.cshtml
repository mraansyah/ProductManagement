@model Data.ViewModels.ProductListViewModel

@{
  ViewData["Title"] = "Product Management";
  Layout = "_Layout";
}

<div class="container-fluid mt-3">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Product Management</h3>
    <div>
      <a asp-controller="Product" asp-action="Create" class="btn btn-primary">+ Tambah Product</a>

      <div class="btn-group">
        <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
          Download
        </button>
        <ul class="dropdown-menu">
          <li>
            <a class="dropdown-item" asp-controller="Product" asp-action="Download" asp-route-format="csv"
               asp-route-search="@Model.SearchQuery">
              CSV
            </a>
          </li>
          <li>
            <a class="dropdown-item" asp-controller="Product" asp-action="Download" asp-route-format="excel"
               asp-route-search="@Model.SearchQuery">
              Excel
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  @if (ViewBag.ErrorMessage != null)
  {
    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
  }

  @if (TempData["SuccessMessage"] != null)
  {
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
  }

  @if (TempData["ErrorMessage"] != null)
  {
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
  }

  <form asp-controller="Product" asp-action="Index" method="get" class="mb-3">
    <div class="input-group" style="max-width: 400px;">
      <input type="text" name="search" value="@Model.SearchQuery" class="form-control"
             placeholder="Search product..." />
      <button type="submit" class="btn btn-outline-primary">Search</button>
      @if (!string.IsNullOrEmpty(Model.SearchQuery))
      {
        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary">Reset</a>
      }
    </div>
  </form>

  <div class="card">
    <div class="card-body">
      @if (Model.Products.Count == 0)
      {
        <p class="text-muted text-center py-4">Tidak ada data product yang ditemukan.</p>
      }
      else
      {
        <table class="table table-striped align-middle">
          <thead>
            <tr>
              <th>Product</th>
              <th>Category</th>
              <th>Price</th>
              <th>Stock</th>
              <th>Rating</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var p in Model.Products)
            {
              <tr>
                <td>@p.Title</td>
                <td>@p.Category</td>
                <td>$@p.Price</td>
                <td>@p.Stock</td>
                <td>@p.Rating</td>
                <td>
                  <a asp-controller="Product" asp-action="Detail" asp-route-id="@p.Id"
                     class="btn btn-sm btn-outline-info">Detail</a>
                  <a asp-controller="Product" asp-action="Edit" asp-route-id="@p.Id"
                     class="btn btn-sm btn-outline-warning">Edit</a>
                  <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmDelete(@p.Id, '@p.Title')">
                    Delete
                  </button>
                </td>
              </tr>
            }
          </tbody>
        </table>

        <!-- Pagination -->
        <nav>
          <ul class="pagination justify-content-center">
            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
              <a class="page-link" asp-controller="Product" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)"
                 asp-route-search="@Model.SearchQuery">
                Previous
              </a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
              <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                <a class="page-link" asp-controller="Product" asp-action="Index" asp-route-page="@i"
                   asp-route-search="@Model.SearchQuery">
                  @i
                </a>
              </li>
            }

            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
              <a class="page-link" asp-controller="Product" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)"
                 asp-route-search="@Model.SearchQuery">
                Next
              </a>
            </li>
          </ul>
        </nav>
      }
    </div>
  </div>
</div>

<form id="deleteForm" asp-controller="Product" asp-action="Delete" method="post">
  @Html.AntiForgeryToken()
  <input type="hidden" id="deleteId" name="id" />
</form>

@section Scripts {
  <script>
    @if (TempData["NewProduct"] != null)
      {
        <text>
            (function () {
                            const newProduct = @Html.Raw(TempData["NewProduct"]);
            newProduct.isLocal = true;
            let local = JSON.parse(localStorage.getItem('localProducts') || '[]');
            local.unshift(newProduct);
            localStorage.setItem('localProducts', JSON.stringify(local));
                        })();
        </text>
    }

            const currentPage = @Model.CurrentPage;
    const searchQuery = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SearchQuery ?? ""));

    function renderLocalProducts() {
      if (currentPage !== 1) return;

      let local = JSON.parse(localStorage.getItem('localProducts') || '[]');

      if (searchQuery) {
        local = local.filter(p => p.title.toLowerCase().includes(searchQuery.toLowerCase()));
      }

      if (local.length === 0) return;

      const tbody = document.querySelector('table tbody');
      if (!tbody) return;

      local.slice().reverse().forEach(p => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
                        <td>${p.title} <span class="badge bg-secondary">Local</span></td>
                        <td>${p.category}</td>
                        <td>$${p.price}</td>
                        <td>${p.stock}</td>
                        <td>${p.rating ?? '-'}</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled title="Data lokal, tidak tersedia di API">Detail</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled title="Data lokal, tidak tersedia di API">Edit</button>
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteLocalProduct(${p.id})">Delete</button>
                        </td>
                    `;
        tbody.prepend(tr);
      });
    }

    function deleteLocalProduct(id) {
      if (!confirm("Apakah Anda yakin ingin menghapus product ini?")) return;

      let local = JSON.parse(localStorage.getItem('localProducts') || '[]');
      local = local.filter(p => p.id !== id);
      localStorage.setItem('localProducts', JSON.stringify(local));
      location.reload();
    }

    function confirmDelete(id, title) {
      if (confirm("Apakah Anda yakin ingin menghapus product '" + title + "'?")) {
        document.getElementById('deleteId').value = id;
        document.getElementById('deleteForm').submit();
      }
    }

    document.addEventListener('DOMContentLoaded', renderLocalProducts);
  </script>
}