@model Data.Models.Product

@{
  ViewData["Title"] = "Detail Product";
  Layout = "_Layout";
}

<div class="container mt-3">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Detail Product</h3>
    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary">Kembali</a>
  </div>

  <div class="card">
    <div class="row g-0">
      <div class="col-md-4">
        <img src="@Model.Thumbnail" class="img-fluid rounded-start p-3" alt="@Model.Title" />
      </div>
      <div class="col-md-8">
        <div class="card-body">
          <h4 class="card-title">@Model.Title</h4>
          <p class="card-text text-muted">@Model.Description</p>

          <table class="table table-borderless">
            <tr>
              <th style="width: 150px;">Category</th>
              <td>@Model.Category</td>
            </tr>
            <tr>
              <th>Brand</th>
              <td>@(Model.Brand ?? "-")</td>
            </tr>
            <tr>
              <th>Price</th>
              <td>$@Model.Price</td>
            </tr>
            <tr>
              <th>Stock</th>
              <td>@Model.Stock</td>
            </tr>
            <tr>
              <th>Rating</th>
              <td>@Model.Rating</td>
            </tr>
          </table>

          <a asp-controller="Product" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
        </div>
      </div>
    </div>
  </div>
</div>